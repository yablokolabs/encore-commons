{
  "name": "encore-commons-videos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Videowright project for the Encore Commons demo video. The Sites app in ../ does not read anything from this folder.",
  "scripts": {
    "dev": "npx videowright dev",
    "render": "npx videowright render",
    "postinstall": "bash scripts/patch-videowright.sh",
    "derive": "node scripts/derive-advances.mjs --write",
    "check": "npm run check:timing && npm run check:audio && npm run check:frames",
    "check:timing": "node scripts/derive-advances.mjs --check",
    "check:audio": "node scripts/check-audio.mjs",
    "check:frames": "node scripts/check-frames.mjs",
    "captions": "node scripts/build-captions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "videowright": "^0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
