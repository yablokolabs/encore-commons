# Cloudflare named tunnel for Encore Commons — keeps https://encore.yablokolabs.com
# pointed at the loopback-only Encore Commons backend and comes back automatically
# after a reboot.
#
# INSTALLED AND ENABLED on this VM. Provenance:
#   cp deploy/cloudflared-config.yml ~/.cloudflared/encore-config.yml
#   sudo cp deploy/encore-cloudflared.service /etc/systemd/system/cloudflared-encore.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now cloudflared-encore
#   journalctl -u cloudflared-encore -f
#
# The unit name is `cloudflared-encore` rather than `cloudflared`, because a third
# unit called `cloudflared` would collide with the one already serving
# psst.yablokolabs.com on this VM. The VM runs three independent tunnels:
#
#   psst-backend   16efbd82-808f-44bc-b036-99574f9e5346   psst.yablokolabs.com
#   onme-backend   124233c9-40d6-429a-a8ca-8678744f2d72   onme.yablokolabs.com
#   encore-backend 8aebeca1-b8cd-4594-880c-d6f0ad93eb38   encore.yablokolabs.com
#
# They do not share a hostname, a config file or a service, so restarting one
# cannot interrupt another.
#
# The config lives in a user-writable directory, so this unit deliberately runs
# unprivileged: a tunnel that only dials 127.0.0.1 needs no root.

[Unit]
Description=Cloudflare Tunnel for encore.yablokolabs.com
Documentation=file:/home/azureuser/encore-commons/deploy/cloudflared-config.yml
After=network-online.target encore-backend.service
# Ordering only: cloudflared reconnects to the edge on its own, so the tunnel
# starting before the backend is survivable, just noisy in the journal.
Wants=network-online.target

[Service]
# Type=simple on purpose: cloudflared runs in the foreground and Restart=always
# covers a dropped edge connection. Type=notify would require sd_notify support,
# and a unit that never sends READY=1 hangs for 90s and is killed at start.
Type=simple
User=azureuser
Group=azureuser
# --config is explicit and NOT the default ~/.cloudflared/config.yml: that file
# belongs to the Psst tunnel on this VM, and `tunnel run` with no argument would
# run whichever tunnel it names. The first `route dns` attempt for this project hit
# exactly that trap and pointed encore.yablokolabs.com at the Psst tunnel.
ExecStart=/home/azureuser/.local/bin/cloudflared --no-autoupdate --config /home/azureuser/.cloudflared/encore-config.yml tunnel run

Restart=always

[Install]
WantedBy=multi-user.target
