# Encore Commons environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# On the hosted deployment these must be set as RUNTIME secrets, because the
# hosted app cannot read the local env file.

# --- Required for live Qloo discovery and scoring -------------------------
# Issued hackathon key. Sent only as the X-Api-Key header to the origin below.
QLOO_API_KEY=
# Organiser-supplied hackathon origin. Do not point this at production.
QLOO_API_ORIGIN=https://hackathon.api.qloo.com

# --- Required for CSCS Apertus 1.5 70B grounded wording -------------------
CSCS_INFERENCE_API_KEY=
CSCS_BASE_URL=https://api.inference.cscs.ch/v1
# Kept at 70B. Do not point this at the 8B variant as a silent downgrade.
CSCS_MODEL=swiss-ai/Apertus-v1.5-70B

# --- Optional tuning (defaults shown) ------------------------------------
# The issued hackathon key is rate limited; this keeps a floor between calls.
QLOO_MIN_GAP_MS=250
QLOO_TIMEOUT_MS=12000
QLOO_MAX_ATTEMPTS=3
CSCS_TIMEOUT_MS=30000

# Set to 1 ONLY to run offline against recorded fixtures while no key is
# present. Replay is labelled distinctly in the interface and is never a
# substitute for the live public app.
ENCORE_REPLAY_FIXTURES=0

# --- Local video production only (never a deployed application secret) ----
ELEVENLABS_API_KEY=
